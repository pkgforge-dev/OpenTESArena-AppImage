#!/bin/sh
CONFDIR="${XDG_CONFIG_HOME:-$HOME/.config}/OpenTESArena"
DATADIR="${XDG_DATA_HOME:-$HOME/.local/share}/OpenTESArena"
mkdir -p "$CONFDIR/options" "$DATADIR"
if [ ! -f "$DATADIR/ARENA/Clocks.txt" ]; then
  cp -r "$APPDIR"/bin/data "$DATADIR"
  cp "$APPDIR"/bin/options/options-default.txt "$CONFDIR/options"
  sed -i \
    -e "s|^ArenaPaths=.*|ArenaPaths=$DATADIR/ARENA|" \
    -e "s|^MidiConfig=.*|MidiConfig=$DATADIR/eawpats/timidity.cfg|" \
    -e "s|^ArenaSavesPath=.*|ArenaSavesPath=$DATADIR/ArenaSaves|" \
    "$CONFDIR/options/options-default.txt"
fi
cd "$CONFDIR"
